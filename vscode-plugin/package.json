{
  "name": "ai-commit-message",
  "displayName": "AI Commit Message",
  "description": "Generate Conventional Commit messages with AI from the Source Control panel. Includes publisher-hosted free models and works with any OpenAI-compatible API. 在源代码管理面板用 AI 生成提交信息，内置免费模型，兼容任意 OpenAI 接口。",
  "version": "1.0.0",
  "publisher": "liubsyy",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Liubsyy/ai-commit-message"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "SCM Providers",
    "AI",
    "Machine Learning"
  ],
  "keywords": [
    "git",
    "commit",
    "ai",
    "commit message",
    "conventional commits"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiCommitMessage.generate",
        "title": "AI Generate Commit Message",
        "category": "AI Commit Message",
        "icon": {
          "light": "resources/icons/ai-generate-light.svg",
          "dark": "resources/icons/ai-generate-dark.svg"
        }
      },
      {
        "command": "aiCommitMessage.selectModel",
        "title": "Switch AI Model",
        "category": "AI Commit Message",
        "icon": "$(chevron-down)"
      },
      {
        "command": "aiCommitMessage.openSettings",
        "title": "AI Commit Model Settings…",
        "category": "AI Commit Message"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "aiCommitMessage.generate",
          "group": "navigation@1",
          "when": "scmProvider == git"
        },
        {
          "command": "aiCommitMessage.selectModel",
          "group": "navigation@2",
          "when": "scmProvider == git"
        }
      ]
    },
    "configuration": {
      "title": "AI Commit Message",
      "properties": {
        "aiCommitMessage.diffCharLimit": {
          "type": "number",
          "default": 8000,
          "minimum": 0,
          "description": "Maximum number of diff characters sent to the AI model; 0 means unlimited. 发送给 AI 模型的 diff 字符上限，0 表示不限制。"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc --noEmit && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "1.82.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
